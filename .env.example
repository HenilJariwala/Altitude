# Altitude local configuration example.
# Copy this file to .env and replace placeholders with real values.
# Never commit the real .env file.

# Ollama / RAG
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_EMBED_MODEL=all-minilm
OLLAMA_BASE_URL=http://127.0.0.1:11434
RAG_STRONG_DISTANCE=0.60
RAG_MAX_DISTANCE=0.78
RAG_DEBUG=false
USE_LLM_FOR_RAG=true

# Local database
ALTITUDE_DB_PATH=data/altitude.db

# Admin login
ALTITUDE_ADMIN_USERNAME=admin
ALTITUDE_ADMIN_PASSWORD_HASH=replace-with-generated-hash

# Inventory integration
INVENTORY_API_URL=
INVENTORY_API_VERIFY_SSL=true
INVENTORY_API_TOKEN=
INVENTORY_API_TIMEOUT_SECONDS=12

# SJK Ticketing integration
TICKETING_BASE_URL=http://192.168.0.201:8080/sjk-ticketingsystem/
TICKETING_LOGIN_URL=
TICKETING_DASHBOARD_URL=
TICKETING_CREATE_URL=
TICKETING_DETAIL_URL_TEMPLATE=
TICKETING_USERNAME=
TICKETING_PASSWORD=
TICKETING_TIMEOUT_SECONDS=12

# Altitude resolution-detail follow-up email
# This does not change the email sent by SJK Ticketing. When enabled, Altitude
# sends one additional email containing the technician resolution note.
ALTITUDE_RESOLUTION_EMAIL_ENABLED=false
ALTITUDE_SMTP_HOST=smtp.gmail.com
ALTITUDE_SMTP_PORT=587
ALTITUDE_SMTP_USERNAME=
ALTITUDE_SMTP_PASSWORD=
ALTITUDE_SMTP_FROM_EMAIL=
ALTITUDE_SMTP_FROM_NAME=Altitude IT Support
ALTITUDE_SMTP_REPLY_TO=
ALTITUDE_SMTP_USE_TLS=true
ALTITUDE_SMTP_USE_SSL=false
ALTITUDE_SMTP_TIMEOUT_SECONDS=12
